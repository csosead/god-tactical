  </defs>
  <path d="M 30 4 C 44 4 54 14 54 28 C 54 42 48 56 36 60 L 24 60 C 12 56 6 42 6 28 C 6 14 16 4 30 4 Z"
        fill="url(#b0-{{actor.id}})" stroke="#4a1414" stroke-width="0.8" />
