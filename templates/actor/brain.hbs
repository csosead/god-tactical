    <radialGradient id="b0-{{actor.id}}" cx="50%" cy="35%" r="70%">
      <stop offset="0%" stop-color="#d47272" />
      <stop offset="70%" stop-color="#8c3a3a" />
      <stop offset="100%" stop-color="#4a1414" />
